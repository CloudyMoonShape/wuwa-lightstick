{
  "name": "your-pages-project",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-24",
  "d1_databases": [],
  "env": {
    "preview": {
      "d1_databases": []
    },
    "production": {
      "d1_databases": [
        {
          "binding": "VISITORS_DB",
          "database_name": "your-visitor-database",
          "database_id": "YOUR_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
